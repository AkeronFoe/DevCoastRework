diff --git a/src/main/java/com/example/devcoast/config/PaginaModelo.java b/src/main/java/com/example/devcoast/config/PaginaModelo.java
index e091d89..c3b1e1e 100644
--- a/src/main/java/com/example/devcoast/config/PaginaModelo.java
+++ b/src/main/java/com/example/devcoast/config/PaginaModelo.java
@@ -5,12 +5,16 @@ import org.springframework.stereotype.Controller;
 import org.springframework.web.bind.annotation.ControllerAdvice;
 import org.springframework.web.bind.annotation.ModelAttribute;
 
+import com.example.devcoast.service.UrlSegura;
+
 import jakarta.servlet.http.HttpServletRequest;
 
 // datos que comparten las plantillas públicas: la dirección base (para la vista previa al compartir el enlace) y el contacto del equipo
 @ControllerAdvice(annotations = Controller.class)
 public class PaginaModelo {
 
+    private static final UrlsVista URLS = new UrlsVista();
+
     private final String urlPublica;
     private final String contacto;
 
@@ -34,4 +38,16 @@ public class PaginaModelo {
     public String contactoCorreo() {
         return contacto;
     }
+
+    @ModelAttribute("urls")
+    public UrlsVista urls() {
+        return URLS;
+    }
+
+    public static final class UrlsVista {
+
+        public String segura(String url) {
+            return UrlSegura.paraMostrar(url);
+        }
+    }
 }
