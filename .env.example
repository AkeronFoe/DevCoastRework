# Copia este archivo como .env y rellena con tus credenciales reales.
# NUNCA subas el .env real a git. Agrega .env a .gitignore.

MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/DevCoast?appName=Cluster0

CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Datos de ejemplo (opcional). Con SEED_ENABLED=true la app crea miles de talentos, empresas, ofertas,
# solicitudes, chats, etc. la primera vez que arranca. Cuentas demo (clave demo1234):
# demo@devcoast.co, diseno@devcoast.co, empresa@devcoast.co, startup@devcoast.co
SEED_ENABLED=false
SEED_TALENTOS=8000
SEED_EMPRESAS=2000
