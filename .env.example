# Copia este archivo como .env y rellena con tus credenciales reales.
# NUNCA subas el .env real a git. Agrega .env a .gitignore.

MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/DevCoast?appName=Cluster0

CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
